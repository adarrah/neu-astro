---

<Layout>
	<Header transparent={true} />

	<main id="content" class="site-main">
		<!-- Hero Section -->
		<section
			class="relative min-h-screen w-full bg-cover bg-center flex items-center justify-center px-5 md:px-6 lg:px-3"
			style="background-image: url('/images/hero-uptown.jpg');"
		>
			<div class="absolute inset-0 bg-neutral/55 pointer-events-none"></div>
			<div class="relative z-10 max-w-6xl w-full mx-auto">
				<div class="m-6 lg:m-12 text-center">
					<h1 class="font-display text-5xl sm:text-6xl md:text-7xl leading-none text-primary mt-8 mb-4 lg:mt-0 lg:mb-3 font-semibold">
						Moving Our<br />Neighborhoods<br />Forward
					</h1>
					<p class="text-xl sm:text-2xl md:text-3xl leading-normal text-neutral-content mb-5">
						<em>Join your neighbors in building a more walkable, transit-oriented, housing rich Far North Side</em>.
					</p>
					<div class="leading-none">
						<a
							href="/newsletter-signup/"
							class="btn btn-info rounded-full border-0 text-info-content font-serif font-bold text-sm capitalize tracking-wider px-5"
						>
							Get Involved
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Main Body Container -->
		<div class="max-w-6xl w-full mx-auto px-6 py-12 space-y-16">
			<!-- Who We Are Section -->
			<section class="flex flex-col md:flex-row gap-6 items-stretch w-full">
				<div class="md:basis-1/3 text-left">
					<h2 class="font-display text-5xl leading-none text-secondary m-0">
						Who We Are
					</h2>
					<div class="divider w-1/3 my-2"></div>
					<p class="text-xl leading-relaxed text-secondary mb-10">
						Neighbors of Edgewater and Uptown (NEU) is a grassroots group of Uptown and Edgewater neighbors working to make our streets livelier, our housing more accessible, and our community stronger. Together, we take action to shape a neighborhood that welcomes everyone.
					</p>
					<a href="/about/" class="inline-flex uppercase text-sm tracking-widest text-secondary hover:text-accent no-underline transition-colors">
						Learn more on “About us”
					</a>
				</div>
				<div class="md:basis-2/3 flex items-center justify-center">
					<figure class="m-0 flex justify-center">
						<img
							src="/images/who-we-are.jpg"
							alt="(c)dale fast 773 502 0455"
							width="646"
							height="466"
							loading="lazy"
							class="max-w-2xl w-full h-auto block"
						/>
					</figure>
				</div>
			</section>

			<!-- 6 Focus Areas Grid Section -->
			<section class="grid grid-cols-1 w-full py-2.5">
				<div class="w-screen -mx-[calc(50vw-50%)] flex justify-center bg-primary/50 px-6 lg:px-0">
					<div class="w-full flex flex-col md:flex-row justify-center items-stretch">
						{focusAreasRow1.map((item) => (
							<div
								class:list={[
									'w-full md:w-1/2 lg:w-1/4 p-8 lg:p-10 border md:border-2 border-secondary text-center flex flex-col items-center justify-start',
									item.theme === 'blue' ? 'bg-accent text-accent-content' : 'bg-primary text-primary-content',
								]}
							>
								<h3 class="font-display text-4xl text-current mb-7">
									{item.boldTitle ? <strong>{item.title}</strong> : item.title}
								</h3>
								<p class="text-base text-current mb-12 leading-relaxed">{item.description}</p>
							</div>
						))}
					</div>
				</div>

				<div class="w-screen -mx-[calc(50vw-50%)] flex justify-center bg-accent/50 px-6 lg:px-0">
					<div class="w-full flex flex-col md:flex-row justify-center items-stretch">
						{focusAreasRow2.map((item) => (
							<div
								class:list={[
									'w-full md:w-1/2 lg:w-1/4 p-8 lg:p-10 border md:border-2 border-secondary text-center flex flex-col items-center justify-start',
									item.theme === 'blue' ? 'bg-accent text-accent-content' : 'bg-primary text-primary-content',
								]}
							>
								<h3 class="font-display text-4xl text-current mb-7">{item.title}</h3>
								<p class="text-base text-current mb-12 leading-relaxed">{item.description}</p>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- How You Can Get Involved + Newsletter Section -->
			<section class="max-w-6xl w-full mx-auto flex flex-col lg:flex-row items-center justify-center gap-5">
				<div class="w-full lg:w-1/2">
					<div class="bg-base-200 pt-8 pb-16 flex flex-col gap-5">
						<h2 class="font-display text-4xl pr-12 text-neutral m-0">
							<strong>How You Can Get Involved</strong>
						</h2>
						<div class="w-3/4 border-t border-neutral my-1"></div>
						<ul class="ml-5 p-0 list-disc text-xl text-secondary space-y-2">
							<li>Attend a monthly NEU meeting</li>
							<li>Sign up for our Newsletter to receive local event reminders and updates</li>
							<li>
								<a
									href="https://join.slack.com/t/edgewaterupto-heh1970/shared_invite/zt-3oktvgk77-kDEgVtLqx3AieGVeSzcqMQ"
									target="_blank"
									rel="noopener"
								>
									Join our Slack community to volunteer on a project
								</a>
							</li>
							<li>Connect with your Ward office and Block Club</li>
							<li>Write letters to the editor or sign petitions</li>
						</ul>
						<div class="flex justify-start mt-2.5">
							<a
								class="btn btn-info rounded-full border-0 text-info-content font-display text-xl font-normal tracking-wide px-7 lg:w-1/2"
								href="https://docs.google.com/document/d/131Fdmr3gRA7N2igFbJBBwc5aNdJ4sZcxrglVV1fcbbg/edit?usp=sharing"
								target="_blank"
								rel="noreferrer noopener"
							>
								Resources to Get Involved
							</a>
						</div>
					</div>
				</div>

				<div class="w-full lg:w-1/2 p-2.5 lg:pl-20 flex justify-center items-center">
					<!-- Live Sender.net Form Embed (falls back gracefully if offline/blocked) -->
					<div class="sender-form-field w-full" data-sender-form-id="mfwtuktjegjyby5euvd"></div>
				</div>
			</section>

			<!-- Connect With Us Online Section -->
			<section class="flex flex-col md:flex-row items-center gap-6 w-full">
				<div class="w-full md:basis-2/5 p-2.5 flex flex-col items-center gap-5">
					<h2 class="font-display text-4xl text-center m-0">
						Connect With Us Online
					</h2>
					<ul class="text-xl m-0 pl-6 list-disc text-secondary space-y-2.5">
						<li>
							<strong>
								<a href="https://stats.sender.net/forms/egJyBY/view" target="_blank" rel="noreferrer noopener">
									Newsletter:
								</a>
							</strong>{' '}
							Sign up to get updates on events, projects, and neighborhood news straight to your inbox.
						</li>
						<li>
							<strong>
								<a href="https://www.instagram.com/neu_edgewateruptown/" target="_blank" rel="noreferrer noopener">
									Instagram:
								</a>
							</strong>{' '}
							Follow us for event highlights, local updates, and a peek into what we’re up to.
						</li>
						<li>
							<strong>
								<a
									href="https://join.slack.com/t/edgewaterupto-heh1970/shared_invite/zt-3oktvgk77-kDEgVtLqx3AieGVeSzcqMQ"
									target="_blank"
									rel="noopener"
								>
									Slack:
								</a>
							</strong>{' '}
							Join our workspace to chat with neighbors, collaborate on projects, and help shape what we do behind the scenes.
						</li>
						<li>
							<a href="mailto:info@neuchicago.org" target="_blank" rel="noopener">Email:</a>{' '}
							Questions, ideas, or feedback? Email us at{' '}
							<strong>
								<a href="mailto:info@neuchicago.org" target="_blank" rel="noreferrer noopener">
									info@neuchicago.org
								</a>
							</strong>
						</li>
						<li>
							<strong>
								<a href="https://www.linkedin.com/company/neu-chicago/" target="_blank" rel="noreferrer noopener">
									LinkedIn:
								</a>
							</strong>{' '}
							Connect with us professionally and see how urbanism, policy, and community action come together.
						</li>
					</ul>
				</div>

				<div class="w-full md:basis-3/5 p-2.5">
					<div class="grid grid-cols-2 md:grid-cols-3 gap-0">
						{instagramPosts.map((post) => (
							<a
								href={post.href}
								target="_blank"
								rel="noopener noreferrer"
								class="block aspect-square overflow-hidden leading-none group"
								title="Home"
							>
								<img
									src={post.src}
									alt={post.alt}
									loading="lazy"
									class="w-full h-full object-cover block group-hover:scale-105 transition-transform duration-200"
								/>
							</a>
						))}
					</div>
				</div>
			</section>

			<!-- Community Calendar Section -->
			<section class="flex flex-col md:flex-row items-start gap-6 w-full">
				<div class="w-full md:basis-3/5">
					<div class="w-full min-w-72">
						<iframe
							src="https://calendar.google.com/calendar/embed?src=c_8b4163e88d24f07664a2f86afd84bef2394dc7ee792f1c7df63436549a9d15df%40group.calendar.google.com&ctz=America%2FChicago"
							style="border: 0"
							scrolling="no"
							height="600"
							width="100%"
							title="NEU Community Calendar"
							sandbox="allow-scripts allow-same-origin allow-popups"
						></iframe>
					</div>
				</div>

				<div class="w-full md:basis-2/5 p-2.5 flex flex-col items-center">
					<h2 class="font-display text-4xl mb-6 text-center m-0">
						Community Calendar
					</h2>
					<p class="text-xl m-0 text-secondary leading-relaxed">
						We gather events from neighborhood groups, local organizations, and community members across the Far North Side. Anyone can request to add an event, making this a shared space for staying informed and getting involved. Use the calendar to connect with your neighbors and take part in the life of your community.
					</p>
				</div>
			</section>
		</div>
	</main>

	<Footer />
</Layout>
