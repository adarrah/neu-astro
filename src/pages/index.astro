---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const focusAreasRow1 = [
	{
		title: "Housing",
		description:
			"We support dense, mixed-income housing that makes room for more people to live near jobs, transit, and community life.",
		theme: "blue",
	},
	{
		title: "Transit",
		boldTitle: true,
		description:
			"We push to prioritize public transit in our well-served neighborhoods and expand access where it’s most needed.",
		theme: "orange",
	},
	{
		title: "Neighbors",
		description:
			"We help members connect with their block clubs, meet new neighbors, and organize around shared issues.",
		theme: "blue",
	},
];

const focusAreasRow2 = [
	{
		title: "Businesses",
		description:
			"We work to support small and family-owned businesses, new and old, that make our neighborhoods unique and vibrant.",
		theme: "orange",
	},
	{
		title: "Public Services",
		description:
			"We use and advocate for the libraries, schools, parks, and other critical shared resources that make city life possible.",
		theme: "blue",
	},
	{
		title: "Civic Engagement",
		description:
			"We introduce neighbors to local politicians, advocacy groups, and the political process to build lasting civic power.",
		theme: "orange",
	},
];

