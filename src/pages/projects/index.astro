---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageBanner from '../../components/ui/PageBanner.astro';

const projects = [
	{
		title: 'Emanuel Congregation',
		date: 'June 18, 2026',
		href: '/projects/emanuel-congregation/',
		image: '/wp-content/uploads/2026/06/image-15.png',
		alt: 'Emanuel Congregation redevelopment rendering',
	},
];
---

<Layout
	title="Projects - Neighbors of Edgewater and Uptown"
	description="Neighborhood development and advocacy projects supported by Neighbors of Edgewater and Uptown."
>
	<Header transparent={false} />

	<main id="content" class="site-main">
		<PageBanner title="Projects" />

		<section class="max-w-5xl mx-auto py-16 px-6 pb-24">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 justify-items-center">
				{
					projects.map((proj) => (
						<article class="card bg-base-100 border border-neutral/20 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all overflow-hidden w-full max-w-md text-center">
							<figure class="aspect-3/2 overflow-hidden bg-base-200">
								<a href={proj.href} class="block w-full h-full">
									<img
										src={proj.image}
										alt={proj.alt}
										loading="lazy"
										class="w-full h-full object-cover"
									/>
								</a>
							</figure>
							<div class="card-body items-center p-7 gap-2.5">
								<h3 class="font-display text-3xl font-semibold m-0">
									<a
										href={proj.href}
										class="text-secondary hover:text-primary no-underline transition-colors"
									>
										{proj.title}
									</a>
								</h3>
								<time class="text-sm text-accent font-semibold">{proj.date}</time>
								<div class="card-actions pt-3">
									<a href={proj.href} class="btn btn-primary text-primary-content">
										Read More
									</a>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</section>
	</main>

	<Footer />
</Layout>
