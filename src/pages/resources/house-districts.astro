---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MapboxMap from '../../components/MapboxMap.astro';

const houseDistricts = [
	{
		district: '11th District',
		representative: 'Ann Williams, Representative, 11th District',
		address: '3505 N Ashland Ave Suite B, Chicago, IL 60657',
		phone: '(773) 880-9082',
		email: 'ann@repannwilliams.com',
		website: 'https://www.repannwilliams.com',
	},
	{
		district: '13th District',
		representative: 'Hoan Huynh, Representative, 13th District',
		address: '4753 N Broadway, Chicago, IL 60640',
		phone: '(773) 657-4655',
		email: 'hello@rephoanhuynh.com',
		website: 'https://www.rephoanhuynh.com',
	},
	{
		district: '14th District',
		representative: 'Kelly Cassidy, Representative, 14th District',
		address: '1507 W Morse Ave, Chicago, IL 60626',
		phone: '(773) 784-2002',
		email: 'Info@repcassidy.com',
		website: 'https://www.repcassidy.com',
	},
	{
		district: '16th District',
		representative: 'Kevin Olickal, Representative, 16th District',
		address: '3851 W Devon Ave, Chicago, IL 60659',
		phone: '(847) 673-1131',
		email: 'info@repkevinolickal.com',
		website: 'https://staterepkevinolickal.com',
	},
];
---

<Layout
	title="State House Districts - Neighbors of Edgewater and Uptown"
	description="View the map of Illinois State House Districts in Edgewater & Uptown and find your State Representative."
>
	<Header transparent={false} />

	<main id="content" class="site-main">
		<section class="resource-subpage-hero">
			<div class="resource-subpage-inner">
				<div class="resource-header-grid">
					<div class="resource-header-text">
						<p class="eyebrow">Edgewater &amp; Uptown</p>
						<h1>State House Districts</h1>
						<p>
							View the map of State House Districts below to find your representative and get involved today.
						</p>
					</div>
					<div class="resource-header-map">
						<MapboxMap mapId="state-house-districts" />
					</div>
				</div>
			</div>
		</section>

		<section class="directory-section">
			<div class="directory-grid">
				{
					houseDistricts.map((item) => (
						<div class="directory-card">
							<h3>{item.district}</h3>
							<p class="office-details">
								<strong>{item.representative}</strong>
								<br />
								<em>{item.address}</em>
								<br />
								{item.phone}
								<br />
								<a href={`mailto:${item.email}`}>{item.email}</a>
								<br />
								<a href={item.website} target="_blank" rel="noopener noreferrer">
									{item.website} <span class="ext-arrow">↗</span>
								</a>
							</p>
						</div>
					))
				}
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.resource-subpage-hero {
		background-color: var(--ast-global-color-4);
		padding: 64px 24px;
		border-bottom: 1px solid var(--ast-global-color-6);
	}

	.resource-subpage-inner {
		max-width: 1200px;
		margin: 0 auto;
	}

	.resource-header-grid {
		display: grid;
		grid-template-columns: 1fr 1.25fr;
		gap: 48px;
		align-items: center;
	}

	@media (max-width: 920px) {
		.resource-header-grid {
			grid-template-columns: 1fr;
		}
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 13px;
		font-weight: 700;
		color: var(--ast-global-color-0);
		margin: 0 0 8px 0;
	}

	.resource-header-text h1 {
		margin: 0 0 16px 0;
	}

	.resource-header-text p {
		font-size: 17px;
		line-height: 1.65;
		margin: 0 0 16px 0;
	}

	.directory-section {
		max-width: 1200px;
		margin: 0 auto;
		padding: 64px 24px 88px;
	}

	.directory-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 32px;
	}

	@media (max-width: 780px) {
		.directory-grid {
			grid-template-columns: 1fr;
		}
	}

	.directory-card {
		background: #fff;
		border: 1px solid var(--ast-global-color-6);
		border-radius: 8px;
		padding: 32px;
	}

	.directory-card h3 {
		margin: 0 0 16px 0;
		padding-bottom: 12px;
		border-bottom: 2px solid var(--ast-global-color-0);
		color: var(--ast-global-color-2);
	}

	.office-details {
		margin: 0;
		line-height: 1.8;
		font-size: 16px;
	}

	.office-details a {
		color: var(--ast-global-color-0);
	}

	.ext-arrow {
		font-family: monospace;
		font-size: 14px;
		background: var(--ast-global-color-4);
		padding: 1px 5px;
		border-radius: 4px;
		color: var(--ast-global-color-3);
	}
</style>

