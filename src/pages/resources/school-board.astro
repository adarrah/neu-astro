---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MapboxMap from '../../components/MapboxMap.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ResourceGrid from '../../components/ui/ResourceGrid.astro';
import DirectoryCard from '../../components/ui/DirectoryCard.astro';

const schoolBoardDistricts = [
	{
		district: 'District 2B',
		member: 'Debby Pope, 2B School Board Member',
		email: 'dpope16@cps.edu',
		website: 'https://www.cpsboe.org/about/bios/2030',
	},
	{
		district: 'District 4A',
		member: 'Karen Zaccor, 4A School Board Member',
		email: 'kzaccor1@cps.edu',
		website: 'https://www.cpsboe.org/about/bios/2038',
	},
];
---

<Layout
	title="School Board Districts - Neighbors of Edgewater and Uptown"
	description="View the map of Chicago School Board Districts in Edgewater & Uptown to find your representative."
>
	<Header transparent={false} />

	<main id="content" class="site-main">
		<PageHero eyebrow="Edgewater & Uptown" title="School Board Districts">
			<p>
				The Chicago School Board is a newly elected public office for letting us decide who will govern Chicago Public Schools. The members of the School Board control the budget, property tax levy, and the CPS superintendent.
			</p>
			<p>View the map of Districts below to find your School Board representative.</p>
			<MapboxMap slot="media" mapId="school-board-districts" />
		</PageHero>

		<ResourceGrid columns={2}>
			{schoolBoardDistricts.map((item) => (
				<DirectoryCard
					title={item.district}
					subtitle={item.member}
					email={item.email}
					website={item.website}
					websiteLabel="CPS Board Bio"
				/>
			))}
		</ResourceGrid>
	</main>

	<Footer />
</Layout>
