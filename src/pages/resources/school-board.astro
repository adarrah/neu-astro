---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MapboxMap from '../../components/MapboxMap.astro';

const schoolBoardDistricts = [
	{
		district: 'District 2B',
		member: 'Debby Pope, 2B School Board Member',
		email: 'dpope16@cps.edu',
		website: 'https://www.cpsboe.org/about/bios/2030',
	},
	{
		district: 'District 4A',
		member: 'Karen Zaccor, 4A School Board Member',
		email: 'kzaccor1@cps.edu',
		website: 'https://www.cpsboe.org/about/bios/2038',
	},
];
---

<Layout
	title="School Board Districts - Neighbors of Edgewater and Uptown"
	description="View the map of Chicago School Board Districts in Edgewater & Uptown to find your representative."
>
	<Header transparent={false} />

	<main id="content" class="site-main">
		<section class="resource-subpage-hero">
			<div class="resource-subpage-inner">
				<div class="resource-header-grid">
					<div class="resource-header-text">
						<p class="eyebrow">Edgewater &amp; Uptown</p>
						<h1>School Board Districts</h1>
						<p>
							The Chicago School Board is a newly elected public office for letting us decide who will govern Chicago Public Schools. The members of the School Board control the budget, property tax levy, and the CPS superintendent.
						</p>
						<p>View the map of Districts below to find your School Board representative.</p>
					</div>
					<div class="resource-header-map">
						<MapboxMap mapId="4376" />
					</div>
				</div>
			</div>
		</section>

		<section class="directory-section">
			<div class="directory-grid">
				{
					schoolBoardDistricts.map((item) => (
						<div class="directory-card">
							<h3>{item.district}</h3>
							<p class="office-details">
								<strong>{item.member}</strong>
								<br />
								<a href={`mailto:${item.email}`}>{item.email}</a>
								<br />
								<a href={item.website} target="_blank" rel="noopener noreferrer">
									{item.website} <span class="ext-arrow">↗</span>
								</a>
							</p>
						</div>
					))
				}
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.resource-subpage-hero {
		background-color: var(--ast-global-color-4);
		padding: 64px 24px;
		border-bottom: 1px solid var(--ast-global-color-6);
	}

	.resource-subpage-inner {
		max-width: 1200px;
		margin: 0 auto;
	}

	.resource-header-grid {
		display: grid;
		grid-template-columns: 1fr 1.25fr;
		gap: 48px;
		align-items: center;
	}

	@media (max-width: 920px) {
		.resource-header-grid {
			grid-template-columns: 1fr;
		}
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 13px;
		font-weight: 700;
		color: var(--ast-global-color-0);
		margin: 0 0 8px 0;
	}

	.resource-header-text h1 {
		margin: 0 0 16px 0;
	}

	.resource-header-text p {
		font-size: 17px;
		line-height: 1.65;
		margin: 0 0 16px 0;
	}

	.directory-section {
		max-width: 1200px;
		margin: 0 auto;
		padding: 64px 24px 88px;
	}

	.directory-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 32px;
	}

	@media (max-width: 780px) {
		.directory-grid {
			grid-template-columns: 1fr;
		}
	}

	.directory-card {
		background: #fff;
		border: 1px solid var(--ast-global-color-6);
		border-radius: 8px;
		padding: 32px;
	}

	.directory-card h3 {
		margin: 0 0 16px 0;
		padding-bottom: 12px;
		border-bottom: 2px solid var(--ast-global-color-0);
		color: var(--ast-global-color-2);
	}

	.office-details {
		margin: 0;
		line-height: 1.8;
		font-size: 16px;
	}

	.office-details a {
		color: var(--ast-global-color-0);
	}

	.ext-arrow {
		font-family: monospace;
		font-size: 14px;
		background: var(--ast-global-color-4);
		padding: 1px 5px;
		border-radius: 4px;
		color: var(--ast-global-color-3);
	}
</style>

