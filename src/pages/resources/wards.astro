---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MapboxMap from '../../components/MapboxMap.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ResourceGrid from '../../components/ui/ResourceGrid.astro';
import DirectoryCard from '../../components/ui/DirectoryCard.astro';

const wards = [
	{
		ward: '40th Ward',
		alderperson: 'Andre Vasquez, Alderman 40th Ward',
		address: '5620 N Western Ave, Chicago, IL 60659',
		phone: '(773) 654-1867',
		email: 'info@40thward.org',
		website: 'http://40thward.org/',
	},
	{
		ward: '47th Ward',
		alderperson: 'Matt Martin, Alderman 47th Ward',
		address: '4243 N Lincoln Ave, Chicago, IL 60618',
		phone: '(773) 868-4747',
		email: 'info@aldermanmartin.com',
		website: 'http://www.aldermanmartin.com/',
	},
	{
		ward: '46th Ward',
		alderperson: 'Angela Clay, Alderwoman 46th Ward',
		address: '4544 N Broadway, Chicago, IL 60640',
		phone: '(773) 878-4646',
		email: 'info@46thward.com',
		website: 'https://www.46thward.com/',
	},
	{
		ward: '48th Ward',
		alderperson: 'Leni Manaa-Hoppenworth, Alderwoman 48th Ward',
		address: '1129 W Bryn Mawr Ave, Chicago, IL 60660',
		phone: '(773) 784-5277',
		email: 'info@the48thward.org',
		website: 'https://the48thward.org/',
	},
];
---

<Layout
	title="Wards - Neighbors of Edgewater and Uptown"
	description="Find your Edgewater & Uptown Ward office and Alderman/Alderwoman contact information."
>
	<Header transparent={false} />

	<main id="content" class="site-main">
		<PageHero eyebrow="Edgewater & Uptown" title="Wards">
			<p>
				Wards are our most local elected representatives. They represent our communities at city council and in turn strive to hear from their communities as much as possible. They are a hub for community resources, a well-spring of local knowledge, and the people who will fight on our behalf to get stuff done.
			</p>
			<p>View the map of Wards below to find your ward and get involved today.</p>
			<MapboxMap slot="media" mapId="wards" />
		</PageHero>

		<ResourceGrid columns={2}>
			{wards.map((item) => (
				<DirectoryCard
					title={item.ward}
					subtitle={item.alderperson}
					address={item.address}
					phone={item.phone}
					email={item.email}
					website={item.website}
					websiteLabel="Ward Website"
				/>
			))}
		</ResourceGrid>
	</main>

	<Footer />
</Layout>
