---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Slideshow from '../../components/Slideshow.astro';

const resourceCards = [
	{
		title: 'Ward Office Information',
		image: '/wp-content/uploads/2025/12/edgewater_office-1024x780.webp',
		alt: 'Edgewater ward office',
		description:
			'Engaging with your ward office is one of the most direct ways to shape local decisions. These offices are a place to raise concerns, ask questions, find resources, and hold elected officials accountable.',
		href: '/resources/wards/',
	},
	{
		title: 'Block Club Websites',
		image: '/wp-content/uploads/2025/12/Screenshot-2025-12-16-115437-edited.png',
		alt: 'Block clubs map preview',
		description:
			'Community starts on your block. Block clubs are where neighbors share info, organize events, solve problems together, and turn casual hellos into real relationships.',
		href: '/resources/block-clubs/',
	},
	{
		title: 'Chambers of Commerce',
		image: '/wp-content/uploads/2025/12/Untitled-design-41-2-1024x1024.png',
		alt: 'Chambers of Commerce',
		description:
			'Support local businesses while shaping the future of your neighborhood. These groups help connect residents, entrepreneurs, and community organizations around shared economic goals.',
		href: '/resources/chambers/',
	},
];

const slides = [
	{
		src: '/wp-content/uploads/2026/01/CW100925-Lakeview-East-Rush-Hour-Protest-215606-1024x683.jpg',
		alt: 'Broadway Upzoning Rally',
	},
	{
		src: '/wp-content/uploads/2026/01/DEF8473b-1-1024x618.jpg',
		alt: '(C)Dale Fast 773-502-0455',
		caption: '(C)Dale Fast 773-502-0455',
	},
	{
		src: '/wp-content/uploads/2026/01/IMG_0164-1-1024x768.jpg',
		alt: 'NEU community event',
	},
	{
		src: '/wp-content/uploads/2026/01/IMG_3486-771x1024.png',
		alt: 'NEU members organizing',
	},
];
---

<Layout
	title="Resource Guide - Neighbors of Edgewater and Uptown"
	description="A collection of local resources, groups, and spaces that help Edgewater and Uptown neighbors get involved and stay connected."
>
	<Header transparent={false} />

	<main id="content" class="site-main">
		<section class="bg-base-200 py-20 px-6">
			<div class="max-w-6xl mx-auto flex flex-col gap-16">
				<div class="text-center max-w-3xl mx-auto">
					<h1 class="font-display text-4xl md:text-5xl font-semibold text-neutral mb-4">
						Local Resources to Get Involved
					</h1>
					<p class="text-lg text-base-content leading-relaxed m-0">
						A collection of local resources, groups, and spaces that help neighbors get involved and stay connected. Whether you’re new to the area or have lived here for years, this guide is an invitation to meet people, support one another, and be part of the community around you.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{resourceCards.map((card) => (
						<article class="card bg-base-100 border border-neutral/20 shadow-sm hover:shadow-md transition-shadow overflow-hidden">
							<figure class="aspect-4/3 overflow-hidden bg-base-200">
								<img
									src={card.image}
									alt={card.alt}
									loading="lazy"
									class="w-full h-full object-cover"
								/>
							</figure>
							<div class="card-body p-6 gap-3">
								<h3 class="font-display text-2xl font-bold text-neutral m-0">
									{card.title}
								</h3>
								<p class="text-sm md:text-base text-base-content leading-relaxed m-0">
									{card.description}
								</p>
								<div class="card-actions pt-2 mt-auto">
									<a href={card.href} class="btn btn-sm btn-primary hover:bg-accent border-0 rounded-full text-primary-content px-5">
										<span>Learn More</span>
										<span aria-hidden="true">›</span>
									</a>
								</div>
							</div>
						</article>
					))}
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center bg-base-100 border border-neutral rounded-box p-8 md:p-12">
					<div class="lg:col-span-5">
						<h2 class="font-display text-3xl md:text-4xl font-semibold text-neutral mb-4">
							Build Community With Us
						</h2>
						<p class="text-lg text-base-content leading-relaxed m-0">
							Joining NEU is the easiest way to turn your passion into action. Whether you want to learn, volunteer, organize, or just connect with neighbors who care, we’re here to support you every step of the way. Our group welcomes all levels of experience and interest—there’s no pressure, just opportunity. Use our resource guide, join events, and take part in projects that matter to you. Together, we can make real change in our community while building connections that last.
						</p>
					</div>
					<div class="lg:col-span-7">
						<Slideshow slides={slides} aspectRatio="1024 / 683" />
					</div>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
