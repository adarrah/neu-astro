---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/ui/PageHero.astro';
import newsConfig from '../../data/news-sources.json';
import { fetchNeighborhoodNews } from '../../lib/newsFeed';

const { articles, feedErrors } = await fetchNeighborhoodNews();

const communityAreas = Object.entries(newsConfig.communityAreas).map(([id, def]) => ({
	id,
	label: def.label,
}));

const pillars = Object.entries(newsConfig.pillars).map(([id, def]) => ({
	id,
	label: def.label,
}));

const sources = newsConfig.sources.map((s) => ({
	id: s.id,
	name: s.name,
}));

function formatDate(iso: string): string {
	return new Date(iso).toLocaleDateString('en-US', {
		month: 'short',
		day: 'numeric',
		year: 'numeric',
	});
}
---

<Layout
	title="Neighborhood News - Neighbors of Edgewater and Uptown"
	description="Latest Edgewater and Uptown news across housing, transit, safe streets, and community from local Chicago journalism."
>
	<Header transparent={false} />

	<main id="content" class="site-main">
		<PageHero eyebrow="Edgewater & Uptown" title="Neighborhood News">
			<p>
				Curated local reporting on Edgewater and Uptown from{' '}
				{newsConfig.sources.map((s, i) => (
					<>
						{i > 0 && (i === newsConfig.sources.length - 1 ? ' and ' : ', ')}
						<a
							href={s.siteUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="link link-secondary font-semibold"
						>
							{s.name}
						</a>
					</>
				))}
				, organized by community area and NEU's four core pillars.
			</p>
		</PageHero>

		<section class="max-w-6xl mx-auto px-6 py-12 md:py-16">
			<!-- Filter Bar -->
			<div class="card bg-base-100 border border-neutral/20 shadow-sm p-5 mb-10 flex flex-col gap-4">
				<div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
					<div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by Community Area">
						<span class="text-xs font-bold uppercase tracking-wider text-secondary mr-1">
							Community Area:
						</span>
						<button type="button" class="btn btn-xs btn-secondary news-area-btn" data-area="all" aria-pressed="true">
							All Areas
						</button>
						{communityAreas.map((area) => (
							<button
								type="button"
								class="btn btn-xs btn-outline btn-secondary news-area-btn"
								data-area={area.id}
								aria-pressed="false"
							>
								{area.label}
							</button>
						))}
					</div>

					<div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by NEU Pillar">
						<span class="text-xs font-bold uppercase tracking-wider text-secondary mr-1">
							NEU Pillar:
						</span>
						<button type="button" class="btn btn-xs btn-primary news-pillar-btn" data-pillar="all" aria-pressed="true">
							All Pillars
						</button>
						{pillars.map((pillar) => (
							<button
								type="button"
								class="btn btn-xs btn-outline btn-primary news-pillar-btn"
								data-pillar={pillar.id}
								aria-pressed="false"
							>
								{pillar.label}
							</button>
						))}
					</div>
				</div>

				<div class="flex flex-wrap items-center gap-2 pt-3 border-t border-base-300" role="group" aria-label="Filter by News Source">
					<span class="text-xs font-bold uppercase tracking-wider text-secondary mr-1">
						Source:
					</span>
					<button type="button" class="btn btn-xs btn-accent news-source-btn" data-source="all" aria-pressed="true">
						All Sources
					</button>
					{sources.map((source) => (
						<button
							type="button"
							class="btn btn-xs btn-outline btn-accent news-source-btn"
							data-source={source.id}
							aria-pressed="false"
						>
							{source.name}
						</button>
					))}
				</div>
			</div>

			{feedErrors.length > 0 && (
				<div role="status" class="alert alert-warning mb-8 text-sm">
					<span>
						Some feeds could not be reached during this build:{' '}
						{feedErrors.map((e) => e.sourceName).join(', ')}.
					</span>
				</div>
			)}

			{articles.length === 0 ? (
				<div class="card bg-base-100 border border-neutral/20 p-10 text-center">
					<h2 class="font-display text-2xl font-bold text-neutral mb-2">
						No matching neighborhood articles right now
					</h2>
					<p class="text-base-content m-0">
						Check back soon — articles from configured local news feeds are refreshed on each site build.
					</p>
				</div>
			) : (
				<>
					<div id="news-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
						{articles.map((article) => (
							<article
								class="card bg-base-100 border border-neutral/20 shadow-sm hover:shadow-md transition-shadow news-card"
								data-areas={article.communityAreas.join(',')}
								data-pillars={article.pillars.join(',')}
								data-source={article.sourceId}
							>
								{article.imageUrl && (
									<figure class="h-44 overflow-hidden bg-base-200 border-b border-neutral/10">
										<img
											src={article.imageUrl}
											alt={article.title}
											loading="lazy"
											class="w-full h-full object-cover"
										/>
									</figure>
								)}
								<div class="card-body p-6 gap-3">
									<div class="flex flex-wrap items-center justify-between gap-2 text-xs">
										<span class="badge badge-sm badge-secondary text-secondary-content font-semibold">
											{article.sourceName}
										</span>
										<time datetime={article.publishedAt} class="text-base-content/75 font-semibold">
											{formatDate(article.publishedAt)}
										</time>
									</div>

									<h2 class="font-display text-xl font-bold text-neutral leading-snug m-0">
										<a
											href={article.url}
											target="_blank"
											rel="noopener noreferrer"
											class="text-neutral hover:text-primary no-underline transition-colors"
										>
											{article.title}
										</a>
									</h2>

									{article.summary && (
										<p class="text-sm text-base-content leading-relaxed m-0">
											{article.summary}
										</p>
									)}

									<div class="flex flex-wrap gap-1.5 pt-1 mt-auto">
										{article.communityAreas.map((areaId) => (
											<span class="badge badge-xs badge-outline font-semibold">
												{newsConfig.communityAreas[areaId].label}
											</span>
										))}
										{article.pillars.map((pillarId) => (
											<span class="badge badge-xs badge-primary badge-outline font-semibold">
												{newsConfig.pillars[pillarId].label}
											</span>
										))}
									</div>

									<div class="card-actions pt-2 border-t border-base-300 mt-2">
										<a
											href={article.url}
											target="_blank"
											rel="noopener noreferrer"
											class="btn btn-xs btn-secondary text-secondary-content w-full"
										>
											Read on {article.sourceName} <span aria-hidden="true">↗</span>
										</a>
									</div>
								</div>
							</article>
						))}
					</div>

					<div id="news-empty-filter" class="hidden card bg-base-100 border border-neutral/20 p-10 text-center mt-6">
						<p class="font-semibold text-neutral m-0">
							No articles match the selected filters.
						</p>
					</div>
				</>
			)}
		</section>
	</main>

	<Footer />
</Layout>

<script>
	let activeArea = 'all';
	let activePillar = 'all';
	let activeSource = 'all';

	const areaBtns = document.querySelectorAll<HTMLButtonElement>('.news-area-btn');
	const pillarBtns = document.querySelectorAll<HTMLButtonElement>('.news-pillar-btn');
	const sourceBtns = document.querySelectorAll<HTMLButtonElement>('.news-source-btn');
	const cards = document.querySelectorAll<HTMLElement>('.news-card');
	const emptyNotice = document.getElementById('news-empty-filter');

	function applyNewsFilters(): void {
		let visibleCount = 0;
		cards.forEach((card) => {
			const areas = (card.dataset.areas ?? '').split(',').filter(Boolean);
			const pillars = (card.dataset.pillars ?? '').split(',').filter(Boolean);
			const source = card.dataset.source ?? '';
			const matchesArea = activeArea === 'all' || areas.includes(activeArea);
			const matchesPillar = activePillar === 'all' || pillars.includes(activePillar);
			const matchesSource = activeSource === 'all' || source === activeSource;
			const show = matchesArea && matchesPillar && matchesSource;
			card.classList.toggle('hidden', !show);
			if (show) visibleCount++;
		});
		if (emptyNotice) {
			emptyNotice.classList.toggle('hidden', visibleCount > 0);
		}
	}

	function setActiveButton(
		buttons: NodeListOf<HTMLButtonElement>,
		activeAttr: 'area' | 'pillar' | 'source',
		value: string
	): void {
		buttons.forEach((btn) => {
			const isSelected = btn.dataset[activeAttr] === value;
			btn.setAttribute('aria-pressed', String(isSelected));
			btn.classList.toggle('btn-outline', !isSelected);
		});
	}

	areaBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			activeArea = btn.dataset.area ?? 'all';
			setActiveButton(areaBtns, 'area', activeArea);
			applyNewsFilters();
		});
	});

	pillarBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			activePillar = btn.dataset.pillar ?? 'all';
			setActiveButton(pillarBtns, 'pillar', activePillar);
			applyNewsFilters();
		});
	});

	sourceBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			activeSource = btn.dataset.source ?? 'all';
			setActiveButton(sourceBtns, 'source', activeSource);
			applyNewsFilters();
		});
	});
</script>

