---
import { getCollection, render } from 'astro:content';
import LteLayout from '../../../../../../layouts/LteLayout.astro';

export async function getStaticPaths() {
	const allPosts = await getCollection('ltes');
	const sortedPosts = allPosts.sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);

	return sortedPosts.map((post, idx) => {
		const parts = post.data.permalink.replace(/^\/+|\/+$/g, '').split('/');
		const [_, year, month, day, slug] = parts;
		const prevEntry = idx < sortedPosts.length - 1 ? sortedPosts[idx + 1] : null;
		const nextEntry = idx > 0 ? sortedPosts[idx - 1] : null;

		return {
			params: { year, month, day, slug },
			props: {
				post,
				prevPost: prevEntry
					? { title: prevEntry.data.title, permalink: prevEntry.data.permalink }
					: null,
				nextPost: nextEntry
					? { title: nextEntry.data.title, permalink: nextEntry.data.permalink }
					: null,
			},
		};
	});
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<LteLayout
	title={post.data.title}
	pubDate={post.data.pubDate}
	author={post.data.author}
	category={post.data.category}
	excerpt={post.data.excerpt}
	prevPost={prevPost}
	nextPost={nextPost}
>
	<Content />
</LteLayout>
