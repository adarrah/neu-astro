---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Newsletter Signup - Neighbors of Edgewater and Uptown"
	description="Sign up for the Neighbors of Edgewater and Uptown newsletter to receive local event reminders and updates."
>
	<Header transparent={false} />

	<main id="content" class="site-main">
		<section class="max-w-4xl mx-auto py-20 px-6 min-h-[55vh] flex items-center justify-center">
			<div class="sender-form-field w-full" data-sender-form-id="mfwtuktjegjyby5euvd"></div>
		</section>
	</main>

	<Footer />
</Layout>
