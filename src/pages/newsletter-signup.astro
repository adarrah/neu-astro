---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Newsletter Signup - Neighbors of Edgewater and Uptown"
	description="Sign up for the Neighbors of Edgewater and Uptown newsletter to receive local event reminders and updates."
>
	<Header transparent={false} />

	<main id="content" class="site-main">
		<section class="newsletter-container">
			<div class="sender-form-field" data-sender-form-id="mfwtuktjegjyby5euvd"></div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.newsletter-container {
		max-width: 900px;
		margin: 0 auto;
		padding: 80px 24px;
		min-height: 55vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}
</style>

