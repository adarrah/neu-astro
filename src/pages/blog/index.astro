---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageBanner from '../../components/ui/PageBanner.astro';

const allPosts = await getCollection('ltes');
const posts = allPosts.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
	title="Read More from Our Members - Neighbors of Edgewater and Uptown"
	description="Letters to the Editor and articles written by members of Neighbors of Edgewater and Uptown."
>
	<Header transparent={false} />

	<main id="content" class="site-main">
		<PageBanner title="Read More from Our Members" />

		<section class="max-w-6xl mx-auto py-14 px-5 pb-20">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
				{
					posts.map((post) => {
						const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
							year: 'numeric',
							month: 'long',
							day: 'numeric',
							timeZone: 'UTC',
						});
						return (
							<article class="card bg-base-100 border border-neutral/20 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all overflow-hidden">
								{post.data.featuredImage && (
									<figure class="h-60 overflow-hidden bg-base-200">
										<a href={post.data.permalink} class="block w-full h-full">
											<img
												src={post.data.featuredImage.url}
												alt={post.data.featuredImage.alt}
												loading="lazy"
												class="w-full h-full object-cover"
											/>
										</a>
									</figure>
								)}
								<div class="card-body p-6 gap-2.5">
									<span class="text-xs font-bold uppercase tracking-wider text-primary">
										{post.data.category}
									</span>
									<h3 class="font-display text-2xl font-bold leading-snug m-0">
										<a
											href={post.data.permalink}
											class="text-neutral hover:text-primary no-underline transition-colors"
										>
											{post.data.title}
										</a>
									</h3>
									<div class="text-xs text-primary font-semibold">
										<span>By {post.data.author}</span> &bull;{' '}
										<time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
									</div>
									<p class="text-sm text-base-content leading-relaxed m-0 flex-1">
										{post.data.excerpt}
									</p>
									<div class="card-actions pt-3 mt-auto">
										<a
											href={post.data.permalink}
											class="btn btn-sm btn-outline btn-secondary"
										>
											Read More
										</a>
									</div>
								</div>
							</article>
						);
					})
				}
			</div>
		</section>
	</main>

	<Footer />
</Layout>
