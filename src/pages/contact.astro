---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Contact - Neighbors of Edgewater and Uptown"
	description="Get in touch with Neighbors of Edgewater and Uptown via email, Slack, newsletter, or social media."
>
	<Header transparent={false} />

	<main id="content" class="site-main">
		<div class="page-banner">
			<h1>Contact Information</h1>
		</div>

		<section class="contact-container">
			<div class="contact-grid">
				<div class="contact-info">
					<h2>Get in Touch</h2>
					<ul class="contact-links">
						<li>
							<strong><a href="/newsletter-signup/">Newsletter:</a></strong> Sign up to get updates on events, projects, and neighborhood news straight to your inbox.
						</li>
						<li>
							<strong>
								<a href="https://www.instagram.com/neu_edgewateruptown/" target="_blank" rel="noopener noreferrer">
									Instagram:
								</a>
							</strong>{' '}
							Follow us for event highlights, local updates, and a peek into what we’re up to.
						</li>
						<li>
							<strong>
								<a
									href="https://join.slack.com/t/edgewaterupto-heh1970/shared_invite/zt-3oktvgk77-kDEgVtLqx3AieGVeSzcqMQ"
									target="_blank"
									rel="noopener noreferrer"
								>
									Slack:
								</a>
							</strong>{' '}
							Join our workspace to chat with neighbors, collaborate on projects, and help shape what we do behind the scenes.
						</li>
						<li>
							<strong><a href="mailto:info@neuchicago.org">Email:</a></strong> Questions, ideas, or feedback? Email us at{' '}
							<strong><a href="mailto:info@neuchicago.org">info@neuchicago.org</a></strong>
						</li>
						<li>
							<strong>
								<a href="https://www.linkedin.com/company/neu-chicago/" target="_blank" rel="noopener noreferrer">
									LinkedIn:
								</a>
							</strong>{' '}
							Connect with us professionally and see how urbanism, policy, and community action come together.
						</li>
					</ul>
				</div>

				<div class="contact-form-col">
					<h2>Message us</h2>
					<form class="neu-contact-form" action="mailto:info@neuchicago.org" method="post" enctype="text/plain">
						<div class="neu-form-row neu-form-row-2col">
							<div class="neu-form-field">
								<label for="sf-first-name">First Name</label>
								<input type="text" id="sf-first-name" name="First Name" autocomplete="given-name" />
							</div>
							<div class="neu-form-field">
								<label for="sf-last-name">Last Name</label>
								<input type="text" id="sf-last-name" name="Last Name" autocomplete="family-name" />
							</div>
						</div>
						<div class="neu-form-row">
							<div class="neu-form-field">
								<label for="sf-email">Email <span class="required">*</span></label>
								<input type="email" id="sf-email" name="Email" required autocomplete="email" />
							</div>
						</div>
						<div class="neu-form-row">
							<div class="neu-form-field">
								<label for="sf-phone">Phone Number</label>
								<input type="tel" id="sf-phone" name="Phone" autocomplete="tel" placeholder="(312) 555-0123" />
							</div>
						</div>
						<div class="neu-form-row">
							<div class="neu-form-field">
								<label for="sf-message">Message <span class="required">*</span></label>
								<textarea id="sf-message" name="Message" rows="4" required></textarea>
							</div>
						</div>
						<div class="neu-form-submit">
							<button type="submit" class="neu-btn-submit">Submit</button>
						</div>
					</form>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.page-banner {
		background-color: var(--ast-global-color-0);
		padding: 36px 20px;
		text-align: center;
	}

	.page-banner h1 {
		margin: 0;
		color: var(--ast-global-color-5);
	}

	.contact-container {
		max-width: 1140px;
		margin: 0 auto;
		padding: 80px 24px;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 56px;
		align-items: start;
	}

	@media (max-width: 820px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}

	.contact-info h2,
	.contact-form-col h2 {
		margin: 0 0 20px 0;
	}

	.contact-links {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
		font-size: 19px;
		line-height: 1.6;
		color: var(--ast-global-color-3);
	}

	.contact-links a {
		color: var(--ast-global-color-0);
	}

	.neu-contact-form {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.neu-form-row-2col {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	@media (max-width: 600px) {
		.neu-form-row-2col {
			grid-template-columns: 1fr;
		}
	}

	.neu-form-field {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.neu-form-field label {
		font-size: 14px;
		font-weight: 600;
		color: var(--ast-global-color-2);
	}

	.neu-form-field .required {
		color: #dc2626;
	}

	.neu-form-field input,
	.neu-form-field textarea {
		padding: 10px 12px;
		border: 1px solid #cbd5e1;
		border-radius: 4px;
		font-family: var(--body-font);
		font-size: 15px;
		color: var(--ast-global-color-3);
		background: #fff;
	}

	.neu-form-field input:focus,
	.neu-form-field textarea:focus {
		outline: none;
		border-color: var(--ast-global-color-0);
		box-shadow: 0 0 0 2px rgba(215, 147, 91, 0.2);
	}

	.neu-btn-submit {
		padding: 12px 28px;
		background: var(--ast-global-color-0);
		color: #fff;
		border: none;
		border-radius: 4px;
		font-family: var(--body-font);
		font-size: 15px;
		font-weight: 600;
		cursor: pointer;
		transition: background 0.2s ease;
	}

	.neu-btn-submit:hover {
		background: var(--ast-global-color-1);
	}
</style>

