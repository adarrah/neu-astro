---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageBanner from '../components/ui/PageBanner.astro';
---

<Layout
	title="Contact - Neighbors of Edgewater and Uptown"
	description="Get in touch with Neighbors of Edgewater and Uptown via email, Slack, newsletter, or social media."
>
	<Header transparent={false} />

	<main id="content" class="site-main">
		<PageBanner title="Contact Information" />

		<section class="max-w-6xl mx-auto py-20 px-6">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-14 items-start">
				<div>
					<h2 class="font-display text-4xl font-semibold text-neutral m-0 mb-5">
						Get in Touch
					</h2>
					<ul class="list-none p-0 m-0 flex flex-col gap-3.5 text-lg leading-relaxed text-secondary">
						<li>
							<strong><a href="/newsletter-signup/" class="text-primary">Newsletter:</a></strong> Sign up to get updates on events, projects, and neighborhood news straight to your inbox.
						</li>
						<li>
							<strong>
								<a href="https://www.instagram.com/neu_edgewateruptown/" target="_blank" rel="noopener noreferrer" class="text-primary">
									Instagram:
								</a>
							</strong>{' '}
							Follow us for event highlights, local updates, and a peek into what we’re up to.
						</li>
						<li>
							<strong>
								<a
									href="https://join.slack.com/t/edgewaterupto-heh1970/shared_invite/zt-3oktvgk77-kDEgVtLqx3AieGVeSzcqMQ"
									target="_blank"
									rel="noopener noreferrer"
									class="text-primary"
								>
									Slack:
								</a>
							</strong>{' '}
							Join our workspace to chat with neighbors, collaborate on projects, and help shape what we do behind the scenes.
						</li>
						<li>
							<strong><a href="mailto:info@neuchicago.org" class="text-primary">Email:</a></strong> Questions, ideas, or feedback? Email us at{' '}
							<strong><a href="mailto:info@neuchicago.org" class="text-primary">info@neuchicago.org</a></strong>
						</li>
						<li>
							<strong>
								<a href="https://www.linkedin.com/company/neu-chicago/" target="_blank" rel="noopener noreferrer" class="text-primary">
									LinkedIn:
								</a>
							</strong>{' '}
							Connect with us professionally and see how urbanism, policy, and community action come together.
						</li>
					</ul>
				</div>

				<div>
					<h2 class="font-display text-4xl font-semibold text-neutral m-0 mb-5">
						Message us
					</h2>
					<form class="flex flex-col gap-4" action="mailto:info@neuchicago.org" method="post" enctype="text/plain">
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<label class="flex flex-col gap-1.5">
								<span class="text-sm font-semibold text-neutral">First Name</span>
								<input type="text" id="sf-first-name" name="First Name" autocomplete="given-name" class="input input-bordered bg-base-100 w-full rounded" />
							</label>
							<label class="flex flex-col gap-1.5">
								<span class="text-sm font-semibold text-neutral">Last Name</span>
								<input type="text" id="sf-last-name" name="Last Name" autocomplete="family-name" class="input input-bordered bg-base-100 w-full rounded" />
							</label>
						</div>
						<label class="flex flex-col gap-1.5">
							<span class="text-sm font-semibold text-neutral">Email <span class="text-error">*</span></span>
							<input type="email" id="sf-email" name="Email" required autocomplete="email" class="input input-bordered bg-base-100 w-full rounded" />
						</label>
						<label class="flex flex-col gap-1.5">
							<span class="text-sm font-semibold text-neutral">Phone Number</span>
							<input type="tel" id="sf-phone" name="Phone" autocomplete="tel" placeholder="(312) 555-0123" class="input input-bordered bg-base-100 w-full rounded" />
						</label>
						<label class="flex flex-col gap-1.5">
							<span class="text-sm font-semibold text-neutral">Message <span class="text-error">*</span></span>
							<textarea id="sf-message" name="Message" rows="4" required class="textarea textarea-bordered bg-base-100 w-full rounded"></textarea>
						</label>
						<div>
							<button type="submit" class="btn btn-primary hover:bg-accent border-0 text-primary-content px-7 rounded">
								Submit
							</button>
						</div>
					</form>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
