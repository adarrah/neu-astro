---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageBanner from '../../components/ui/PageBanner.astro';

const boardMembers = [
	{
		role: 'President',
		name: 'Neville Hemming (Co-Founder)',
		photo: '/wp-content/uploads/2026/09/IMG_1257-edited-1024x1024.jpg',
		bio: [
			'Neville is a part of NEU because he believes everyone should be able to afford to live in a walkable, transit-oriented community. Neville and his spouse live in the Edgewater community area, and his family has roots in South Shore. A lifelong transit rider, Neville grew up riding Metra and the Purple and Red Lines, helping shape his passion for public transit and walkable communities. Professionally, Neville works in strategy and operations in the mobility sector. He previously served on the board of Walk San Francisco, where he advocated for safer, more pedestrian-friendly streets.',
		],
		since: 'June 24th, 2026',
		email: 'neville@neuchicago.org',
		emailHref: 'mailto:neville@neuchicago.org',
	},
	{
		role: 'Vice President',
		name: 'Allison Darrahill (Co-Founder)',
		photo: '/wp-content/uploads/2026/09/IMG_1262-edited-1024x1024.jpg',
		bio: [
			'Allison Darrahill has been a part of NEU since the beginning. She became involved in community activism as a member of KC Tenants fighting for tenants rights and housing security. In Chicago, she continued her activism and met other organizers at community meetings for the Broadway Upzoning, who came together to form NEU. She is a passionate advocate for transit, housing access, queer community building, and safe cycling. In her professional life, Allison develops Electronic Medical Records software with a focus on improving interoperability between health systems.',
		],
		since: 'June 24th, 2026',
		email: 'allison@neuchicago.org',
		emailHref: 'mailto:allison@neuchicago.org',
	},
	{
		role: 'Secretary',
		name: 'Sarah Hill',
		photo: '/wp-content/uploads/2026/09/IMG_1273-edited-1024x1024.jpg',
		bio: [
			"Sarah Hill has been a part of NEU since September 2025, taking the lead on design, socials, and event planning. She's passionate about building community and caring for Chicagoans through better urban policy. Sarah is currently finishing her undergraduate degree in Psychology & Marketing, and is looking forward to a strong future in communications and public policy.",
		],
		since: 'June 24th, 2026',
		email: 'sarah@neuchicago.com',
		emailHref: 'mailto:hillsarah402@gmail.com',
	},
	{
		role: 'Treasurer',
		name: 'Noah Ayoub (Co-Founder)',
		photo: '/wp-content/uploads/2026/09/profile_placeholder-1024x1024.png',
		bio: [
			'Noah Ayoub has been an active community member and resident of Uptown since moving to Chicago in 2023. He is passionate about good governance reforms and housing policy. Noah is currently pursuing his undergraduate degree in Economics at the University of Illinois at Chicago.',
		],
		since: 'June 24th, 2026',
		email: 'noah@neuchicago.com',
		emailHref: 'mailto:noahayoub1@gmail.com',
	},
	{
		role: 'Events Chair',
		name: "Sofia D'Errico",
		photo: '/wp-content/uploads/2026/09/IMG_1269-edited-1024x1024.jpg',
		bio: [
			'Sofia D’Errico has been an active member of NEU since joining in January 2026, shortly after moving to Uptown in August 2025, drawn by the opportunity to build community and find meaningful ways to make an impact.',
			'She has a passion for community organizing and creating opportunities for neighbors to connect and get involved. She is interested in the intersection of public policy, community development, and social impact- particularly in ways that can make neighborhoods more accessible and vibrant for all.',
			'Sofia holds a Bachelor’s in Political Science as well as a Master’s in Public Administration, and is excited to help NEU grow and strengthen its community through impactful and engaging events. Outside of NEU, Sofia’s work focuses on the advancement of anti-poverty initiatives across the country.',
		],
		since: 'September 13th, 2026',
		email: 'sofia@neuchicago.org',
		emailHref: 'mailto:sofia@neuchicago.org',
	},
	{
		role: 'Membership & Fundraising Chair',
		name: 'Quillan Darrahill (Co-Founder)',
		photo: '/wp-content/uploads/2026/09/IMG_1275-edited.jpg',
		bio: [
			"Quillan Darrahill joined the NEU board as Membership & Fundraising Chair, with the goal of growing community and strengthening NEU's capacity to advocate for more accessible, connected, and vibrant neighborhoods. They are passionate about building communities where infrastructure and policy better serve the people who rely on them. Outside of NEU, Quillan is a water resources engineer.",
		],
		since: 'August 30th, 2026',
		email: 'quillan@neuchicago.org',
		emailHref: 'mailto:quillan@neuchicago.org',
	},
	{
		role: 'Advocacy Chair',
		name: 'Vacant',
		photo: '/wp-content/uploads/2026/09/profile_placeholder-1024x1024.png',
		bio: [],
		vacantNote: 'Contact Us if Interested',
	},
];
---

<Layout
	title="Board Members - Neighbors of Edgewater and Uptown"
	description="Meet the board members of Neighbors of Edgewater and Uptown (NEU)."
>
	<Header transparent={false} />

	<main id="content" class="site-main">
		<PageBanner title="Meet the Board" />

		<section class="max-w-6xl mx-auto py-16 px-6 pb-20">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
				{boardMembers.map((member) => (
					<article class="flex flex-col items-center text-center">
						<figure class="m-0 mb-6 w-64 h-64 rounded-full overflow-hidden shadow-md">
							<img
								src={member.photo}
								alt={member.name}
								class="w-full h-full object-cover block"
								loading="lazy"
							/>
						</figure>
						<h2 class="font-display text-4xl font-semibold text-neutral m-0">
							{member.role}
						</h2>
						<hr class="w-full border-0 border-t-2 border-neutral my-4" />
						<p class="text-2xl font-semibold text-neutral m-0 mb-4">{member.name}</p>
						{member.bio.map((paragraph) => (
							<p class="text-base leading-relaxed text-secondary m-0 mb-3">{paragraph}</p>
						))}
						{member.vacantNote && (
							<p class="text-xl text-secondary m-0">
								<em>{member.vacantNote}</em>
							</p>
						)}
						{member.since && (
							<p class="mt-3 text-sm text-secondary m-0">
								<em>Board Member Since: {member.since}</em>
								{member.email && (
									<>
										<br />
										<br />
										Contact Me at{' '}
										<a href={member.emailHref} class="text-primary hover:text-accent">
											{member.email}
										</a>
									</>
								)}
							</p>
						)}
					</article>
				))}
			</div>
		</section>
	</main>

	<Footer />
</Layout>
