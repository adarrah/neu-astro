---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface NavPost {
	title: string;
	permalink: string;
}

interface Props {
	title: string;
	pubDate: Date;
	author: string;
	category?: string;
	excerpt?: string;
	prevPost?: NavPost | null;
	nextPost?: NavPost | null;
}

const {
	title,
	pubDate,
	author,
	category = 'Letters to the Editor',
	excerpt,
	prevPost,
	nextPost,
} = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<Layout title={`${title} - Neighbors of Edgewater and Uptown`} description={excerpt}>
	<Header transparent={false} />

	<main id="content" class="site-main bg-base-200 py-16 px-5 pb-24">
		<article class="card max-w-3xl mx-auto bg-base-100 border border-base-300 shadow-sm p-8 md:p-14">
			<header class="mb-8 pb-6 border-b border-base-300 space-y-3">
				<div>
					<a href="/blog/" class="badge badge-primary badge-outline font-bold uppercase tracking-wider text-xs no-underline">
						{category}
					</a>
				</div>
				<h1 class="font-display text-3xl md:text-5xl font-semibold text-neutral leading-tight m-0">
					{title}
				</h1>
				<div class="text-sm font-semibold text-primary">
					<span>By {author}</span> &bull; <time datetime={pubDate.toISOString()}>{formattedDate}</time>
				</div>
			</header>

			<div class="space-y-5 text-base md:text-lg leading-relaxed text-base-content [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-neutral [&_h2]:mt-8 [&_a]:link [&_a]:link-primary [&_blockquote]:border-l-4 [&_blockquote]:border-primary [&_blockquote]:pl-4 [&_blockquote]:italic">
				<slot />
			</div>

			<nav class="mt-12 pt-8 border-t border-base-300" aria-label="Post navigation">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
					<div>
						{prevPost && (
							<a href={prevPost.permalink} class="group block no-underline">
								<span class="block text-xs font-bold uppercase tracking-wider text-primary">&larr; Previous Letter</span>
								<span class="block font-display text-lg font-semibold text-neutral group-hover:text-primary transition-colors">
									{prevPost.title}
								</span>
							</a>
						)}
					</div>
					<div class="md:text-center">
						<a href="/blog/" class="btn btn-sm btn-outline btn-secondary">All Letters</a>
					</div>
					<div class="md:text-right">
						{nextPost && (
							<a href={nextPost.permalink} class="group block no-underline">
								<span class="block text-xs font-bold uppercase tracking-wider text-primary">Next Letter &rarr;</span>
								<span class="block font-display text-lg font-semibold text-neutral group-hover:text-primary transition-colors">
									{nextPost.title}
								</span>
							</a>
						)}
					</div>
				</div>
			</nav>
		</article>
	</main>

	<Footer />
</Layout>
