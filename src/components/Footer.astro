---

<footer class="site-footer" id="colophon">
	<div class="site-primary-footer-wrap">
		<div class="footer-primary-grid">
			<div class="footer-col-1">
				<h2>Neighbors of Edgewater and Uptown</h2>
				<h4>
					Creating community, empowering everyone, and acting as a resource for Edgewater and Uptown Community Area neighbors.
				</h4>
			</div>
			<div class="footer-col-2">
				<h2><a href="https://neuchicago.org/contact">Contact Us</a></h2>
				<h4>
					<br /><br />
					Neighbors of Edgewater and Uptown is a registered 501(c)4 organization.<br />
					<a href="mailto:info@neuchicago.org" class="underline-link">info@neuchicago.org</a>
				</h4>
			</div>
		</div>
	</div>

	<div class="site-below-footer-wrap">
		<div class="footer-below-grid">
			<div class="footer-below-col-1">
				<p>Copyright &copy; 2026 Neighbors of Edgewater and Uptown</p>
			</div>
			<div class="footer-below-col-2">
				<a href="/">
					<img
						loading="lazy"
						width="81"
						height="81"
						src="/images/neu-logo.png"
						alt="Neighbors of Edgewater and Uptown"
						class="footer-logo"
					/>
				</a>
			</div>
			<div class="footer-below-col-3">
				<div class="footer-social-wrap">
					{socialLinks.map((item) => (
						<a
							href={item.href}
							aria-label={item.label}
							target={item.href.startsWith('mailto:') ? undefined : '_blank'}
							rel={item.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
							class="footer-social-item"
						>
							<span class="social-icon" aria-hidden="true" set:html={item.icon} />
							<span class="social-label">{item.label}</span>
						</a>
					))}
				</div>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background-color: var(--ast-global-color-0);
		color: var(--ast-global-color-4);
	}

	@media (max-width: 921px) {
		.site-footer {
			padding-left: 25px;
			padding-right: 25px;
		}
	}

	.site-primary-footer-wrap {
		padding-top: 5%;
		padding-bottom: 0;
	}

	@media (max-width: 921px) {
		.site-primary-footer-wrap {
			padding-top: 60px;
			padding-bottom: 60px;
		}
	}

	.footer-primary-grid {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
		align-items: flex-start;
	}

	.footer-col-1 {
		text-align: left;
	}

	.footer-col-1 h2,
	.footer-col-1 h4 {
		color: #ffffff;
	}

	.footer-col-1 h2 {
		margin: 0 0 24px 0;
		font-size: 2.625rem;
		line-height: 1.3em;
	}

	.footer-col-1 h4,
	.footer-col-2 h4 {
		margin: 0;
		font-size: 1.5625rem;
		line-height: 1.2em;
		font-weight: 600;
	}

	.footer-col-2 {
		text-align: right;
		color: var(--ast-global-color-5);
	}

	.footer-col-2 h2 {
		margin: 0;
		font-size: 2.625rem;
		line-height: 1.3em;
		color: var(--ast-global-color-4);
	}

	.footer-col-2 h4 {
		color: var(--ast-global-color-4);
	}

	.footer-col-2 a {
		color: var(--ast-global-color-5);
		text-decoration: none;
	}

	.footer-col-2 a.underline-link {
		text-decoration: underline;
	}

	@media (max-width: 921px) {
		.footer-primary-grid {
			gap: 50px;
		}
		.footer-col-2 {
			text-align: left;
		}
		.footer-col-1 h2,
		.footer-col-2 h2 {
			font-size: 32px;
		}
		.footer-col-1 h4,
		.footer-col-2 h4 {
			font-size: 22px;
		}
	}

	@media (max-width: 544px) {
		.footer-primary-grid {
			grid-template-columns: 1fr;
		}
		.footer-col-1,
		.footer-col-2 {
			text-align: center;
		}
	}

	.site-below-footer-wrap {
		padding-top: 20px;
		padding-bottom: 20px;
		min-height: 40px;
	}

	.footer-below-grid {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		align-items: center;
		gap: 20px;
	}

	.footer-below-col-1 {
		text-align: left;
		color: #f8f8f8;
	}

	.footer-below-col-1 p {
		margin: 0;
		font-size: 1rem;
	}

	.footer-below-col-2 {
		text-align: center;
	}

	.footer-logo {
		width: 81px;
		height: auto;
		display: inline-block;
	}

	.footer-below-col-3 {
		text-align: right;
	}

	.footer-social-wrap {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		align-items: center;
		gap: 12px;
	}

	.footer-social-item {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		color: #f8f8f8;
		padding: 0 0.2em;
		transition: color 0.15s ease;
	}

	.social-icon {
		display: inline-flex;
		align-items: center;
	}

	.social-icon :global(svg) {
		width: 25px;
		height: 25px;
		fill: #f8f8f8;
		transition: fill 0.15s ease;
	}

	.social-label {
		padding-left: 6px;
		color: #f8f8f8;
		font-size: 1rem;
		transition: color 0.15s ease;
	}

	.footer-social-item:hover .social-icon :global(svg) {
		fill: var(--ast-global-color-3);
	}

	.footer-social-item:hover .social-label {
		color: var(--ast-global-color-3);
	}

	@media (max-width: 921px) {
		.footer-below-col-1 {
			text-align: center;
		}
		.footer-social-wrap {
			justify-content: flex-start;
		}
	}

	@media (max-width: 544px) {
		.footer-below-grid {
			grid-template-columns: 1fr;
			gap: 15px;
		}
		.footer-social-wrap {
			justify-content: center;
		}
	}
</style>

