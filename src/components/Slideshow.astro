---
interface Slide {
	src: string;
	alt: string;
	caption?: string;
}

interface Props {
	slides: Slide[];
	aspectRatio?: string;
}

const { slides, aspectRatio = '16 / 9' } = Astro.props;
---

<div class="neu-slideshow relative w-full max-w-4xl mx-auto rounded-lg overflow-hidden bg-neutral shadow-md">
	<div class="relative w-full" style={`aspect-ratio: ${aspectRatio};`}>
		{slides.map((slide, idx) => (
			<div
				class:list={[
					'neu-slide absolute inset-0 transition-opacity duration-500',
					idx === 0 ? 'opacity-100 z-10' : 'opacity-0 pointer-events-none z-0',
				]}
			>
				<figure class="relative w-full h-full m-0">
					<img
						src={slide.src}
						alt={slide.alt}
						loading={idx === 0 ? 'eager' : 'lazy'}
						class="w-full h-full object-cover"
					/>
					{slide.caption && (
						<figcaption class="absolute bottom-0 inset-x-0 bg-black/65 text-white text-xs px-4 py-2">
							{slide.caption}
						</figcaption>
					)}
				</figure>
			</div>
		))}
	</div>

	{slides.length > 1 && (
		<>
			<button
				type="button"
				class="neu-slideshow-btn prev btn btn-circle btn-sm bg-black/60 hover:bg-black/80 border-0 text-white absolute left-3 top-1/2 -translate-y-1/2 z-20"
				aria-label="Previous slide"
			>
				&#8249;
			</button>
			<button
				type="button"
				class="neu-slideshow-btn next btn btn-circle btn-sm bg-black/60 hover:bg-black/80 border-0 text-white absolute right-3 top-1/2 -translate-y-1/2 z-20"
				aria-label="Next slide"
			>
				&#8250;
			</button>
			<div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex gap-2">
				{slides.map((_, idx) => (
					<button
						type="button"
						class:list={[
							'neu-slideshow-dot w-2.5 h-2.5 rounded-full border-0 cursor-pointer transition-colors',
							idx === 0 ? 'bg-primary' : 'bg-white/60 hover:bg-white',
						]}
						aria-label={`Go to slide ${idx + 1}`}
						data-index={idx}
					/>
				))}
			</div>
		</>
	)}
</div>

<script>
	document.querySelectorAll('.neu-slideshow').forEach((slideshow) => {
		const slides = Array.from(slideshow.querySelectorAll('.neu-slide'));
		const dots = Array.from(slideshow.querySelectorAll('.neu-slideshow-dot'));
		const prevBtn = slideshow.querySelector('.neu-slideshow-btn.prev');
		const nextBtn = slideshow.querySelector('.neu-slideshow-btn.next');
		if (slides.length <= 1) return;

		let current = 0;

		function goTo(index: number) {
			current = (index + slides.length) % slides.length;
			slides.forEach((s, idx) => {
				const active = idx === current;
				s.classList.toggle('opacity-100', active);
				s.classList.toggle('z-10', active);
				s.classList.toggle('opacity-0', !active);
				s.classList.toggle('pointer-events-none', !active);
				s.classList.toggle('z-0', !active);
			});
			dots.forEach((d, idx) => {
				const active = idx === current;
				d.classList.toggle('bg-primary', active);
				d.classList.toggle('bg-white/60', !active);
			});
		}

		prevBtn?.addEventListener('click', () => goTo(current - 1));
		nextBtn?.addEventListener('click', () => goTo(current + 1));
		dots.forEach((dot, idx) => {
			dot.addEventListener('click', () => goTo(idx));
		});

		setInterval(() => {
			if (!slideshow.matches(':hover')) {
				goTo(current + 1);
			}
		}, 5000);
	});
</script>
