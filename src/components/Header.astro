---
interface Props {
	transparent?: boolean;
}

const { transparent = true } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
	{ label: "Home", href: "/" },
	{
		label: "About",
		href: "/about/",
		children: [{ label: "Board Members", href: "/about/board/" }],
	},
	{
		label: "Resources",
		href: "/resources/",
		children: [
			{ label: "Block Clubs", href: "/resources/block-clubs/" },
			{ label: "Complete Streets", href: "/resources/complete-streets/" },
			{ label: "Chambers of Commerce", href: "/resources/chambers/" },
			{ label: "Community Calendar", href: "/calendar/" },
			{
				label: "School Board Districts",
				href: "/resources/school-board/",
			},
			{
				label: "State House Districts",
				href: "/resources/house-districts/",
			},
			{ label: "Wards", href: "/resources/wards/" },
		],
	},
	{
		label: "Projects",
		href: "/projects/",
		children: [
			{
				label: "Emanuel Congregation",
				href: "/projects/emanuel-congregation/",
			},
		],
	},
	{ label: "Endorsements", href: "/endorsements/" },
	{ label: "News", href: "/news/" },
	{ label: "Blog", href: "/blog/" },
	{ label: "Contact", href: "/contact/" },
].map((item) => ({
	...item,
	active:
		item.href === "/"
			? currentPath === "/"
			: currentPath.startsWith(item.href) ||
				(item.children?.some((c) => currentPath.startsWith(c.href)) ??
					false),
}));

const slackUrl =
	"https://join.slack.com/t/edgewaterupto-heh1970/shared_invite/zt-3oktvgk77-kDEgVtLqx3AieGVeSzcqMQ";
---

<header
	class:list={[
		"relative z-50 transition-colors",
		transparent
			? "bg-primary border-b border-primary lg:absolute lg:top-0 lg:left-0 lg:right-0 lg:bg-transparent lg:border-b-0"
			: "bg-primary border-b border-primary",
	]}
	id="masthead"
>
	<div class="navbar max-w-7xl mx-auto px-5 py-1 min-h-18 justify-between">
		<div class="flex items-center py-1 shrink-0">
			<a href="/" class="inline-block" rel="home" aria-current="page">
				<img
					width="120"
					height="120"
					src="/images/neu-logo.png"
					class="w-20 sm:w-28 h-auto block transition-all"
					alt="Neighbors of Edgewater and Uptown"
				/>
			</a>
		</div>

		<!-- Desktop Navigation -->
		<div class="hidden lg:flex items-center gap-2.5">
			<nav aria-label="Primary Site Navigation">
				<ul class="menu menu-horizontal p-0 items-center">
					{navItems.map((item) => (
						<li class="dropdown dropdown-hover">
							<a
								href={item.href}
								class:list={[
									"flex items-center gap-1.5 px-3.5 py-5 font-sans text-base font-normal no-underline whitespace-nowrap transition-colors bg-transparent",
									item.active
										? "text-primary-content/90"
										: "text-primary-content hover:text-primary-content/90",
								]}
								aria-current={item.active ? "page" : undefined}
							>
								<span>{item.label}</span>
								{item.children && (
									<svg
										viewBox="57 35.171 26 16.043"
										width="12"
										height="12"
										aria-hidden="true"
									>
										<path
											d="M57.5,38.193l12.5,12.5l12.5-12.5l-2.5-2.5l-10,10l-10-10L57.5,38.193z"
											fill="currentColor"
										/>
									</svg>
								)}
							</a>
							{item.children && (
								<ul class="dropdown-content menu bg-base-200 border-t-4 border-primary shadow-md min-w-60 p-0 z-50 rounded-none">
									{item.children.map((sub) => (
										<li>
											<a
												href={sub.href}
												class="flex items-center gap-2 px-4 py-3.5 text-sm leading-snug text-secondary hover:text-accent hover:bg-base-100 rounded-none no-underline transition-colors"
											>
												<svg
													viewBox="57 35.171 26 16.043"
													width="10"
													height="10"
													aria-hidden="true"
													class="-rotate-90 text-secondary shrink-0"
												>
													<path
														d="M57.5,38.193l12.5,12.5l12.5-12.5l-2.5-2.5l-10,10l-10-10L57.5,38.193z"
														fill="currentColor"
													/>
												</svg>
												<span>{sub.label}</span>
											</a>
										</li>
									))}
								</ul>
							)}
						</li>
					))}
				</ul>
			</nav>

			<div class="ml-2.5">
				<a
					class="btn btn-secondary rounded-full hover:btn-accent border-0 text-secondary-content font-display text-xl font-normal tracking-wide px-5 whitespace-nowrap"
					href={slackUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Join Our Slack"
				>
					Join Our Slack
				</a>
			</div>
		</div>

		<!-- Mobile Menu Trigger -->
		<div class="lg:hidden">
			<button
				type="button"
				class="btn btn-ghost btn-square text-primary-content"
				id="mobile-menu-open"
				aria-expanded="false"
				aria-controls="mobile-drawer"
				aria-label="Main menu toggle"
			>
				<svg
					fill="currentColor"
					width="24"
					height="28"
					viewBox="0 0 24 28"
					aria-hidden="true"
				>
					<path d="M24 21v2c0 0.547-0.453 1-1 1h-22c-0.547 0-1-0.453-1-1v-2c0-0.547 0.453-1 1-1h22c0.547 0 1 0.453 1 1zM24 13v2c0 0.547-0.453 1-1 1h-22c-0.547 0-1-0.453-1-1v-2c0-0.547 0.453-1 1-1h22c0.547 0 1 0.453 1 1zM24 5v2c0 0.547-0.453 1-1 1h-22c-0.547 0-1-0.453-1-1v-2c0-0.547 0.453-1 1-1h22c0.547 0 1 0.453 1 1z"></path>
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile Off-Canvas Drawer -->
	<div
		class="fixed inset-0 z-50 hidden"
		id="mobile-drawer"
		aria-hidden="true"
	>
		<div
			class="fixed inset-0 bg-neutral/50 backdrop-blur-xs"
			id="mobile-drawer-overlay"
		></div>
		<div class="fixed top-0 right-0 bottom-0 w-80 max-w-xs bg-base-100 text-neutral shadow-2xl flex flex-col overflow-y-auto z-10">
			<div class="flex items-center justify-between px-5 py-4 border-b border-base-300">
				<span class="font-display text-xl font-bold text-neutral">
					Menu
				</span>
				<button
					type="button"
					id="mobile-menu-close"
					class="btn btn-ghost btn-sm btn-circle text-neutral"
					aria-label="Close menu"
				>
					<svg
						fill="currentColor"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path d="M5.293 6.707l5.293 5.293-5.293 5.293c-0.391 0.391-0.391 1.024 0 1.414s1.024 0.391 1.414 0l5.293-5.293 5.293 5.293c0.391 0.391 1.024 0.391 1.414 0s0.391-1.024 0-1.414l-5.293-5.293 5.293-5.293c0.391-0.391 0.391-1.024 0-1.414s-1.024-0.391-1.414 0l-5.293 5.293-5.293-5.293c-0.391-0.391-1.024-0.391-1.414 0s-0.391 1.024 0 1.414z"></path>
					</svg>
				</button>
			</div>
			<nav class="p-4 flex-1" aria-label="Mobile Site Navigation">
				<ul class="list-none p-0 m-0 divide-y divide-base-300">
					{navItems.map((item) => (
						<li class="mobile-menu-item py-1">
							<div class="flex items-center justify-between">
								<a
									href={item.href}
									class:list={[
										"py-2.5 px-2 font-semibold text-base no-underline flex-1",
										item.active
											? "text-primary"
											: "text-secondary hover:text-accent",
									]}
								>
									{item.label}
								</a>
								{item.children && (
									<button
										type="button"
										class="mobile-submenu-toggle btn btn-ghost btn-xs"
										aria-expanded="false"
										aria-label={`Toggle ${item.label} submenu`}
									>
										<svg
											viewBox="57 35.171 26 16.043"
											width="14"
											height="14"
											aria-hidden="true"
										>
											<path
												d="M57.5,38.193l12.5,12.5l12.5-12.5l-2.5-2.5l-10,10l-10-10L57.5,38.193z"
												fill="currentColor"
											/>
										</svg>
									</button>
								)}
							</div>
							{item.children && (
								<ul class="mobile-sub-menu hidden list-none pl-4 pb-2 m-0 space-y-1">
									{item.children.map((sub) => (
										<li>
											<a
												href={sub.href}
												class="flex items-center gap-1.5 py-1.5 px-2 text-sm text-secondary hover:text-accent no-underline"
											>
												<span
													class="text-primary"
													aria-hidden="true"
												>
													›
												</span>
												{sub.label}
											</a>
										</li>
									))}
								</ul>
							)}
						</li>
					))}
				</ul>
				<div class="pt-6">
					<a
						class="btn btn-secondary hover:btn-accent rounded-full border-0 text-secondary-content font-display text-xl font-normal w-full"
						href={slackUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						Join Our Slack
					</a>
				</div>
			</nav>
		</div>
	</div>
</header>

<script>
	const openBtn = document.getElementById("mobile-menu-open");
	const closeBtn = document.getElementById("mobile-menu-close");
	const overlay = document.getElementById("mobile-drawer-overlay");
	const drawer = document.getElementById("mobile-drawer");

	function setDrawer(open: boolean) {
		if (!drawer || !openBtn) return;
		drawer.classList.toggle("hidden", !open);
		drawer.setAttribute("aria-hidden", String(!open));
		openBtn.setAttribute("aria-expanded", String(open));
		document.body.style.overflow = open ? "hidden" : "";
		if (open) {
			closeBtn?.focus();
		} else {
			openBtn.focus();
		}
	}

	openBtn?.addEventListener("click", () => setDrawer(true));
	closeBtn?.addEventListener("click", () => setDrawer(false));
	overlay?.addEventListener("click", () => setDrawer(false));
	document.addEventListener("keydown", (e) => {
		if (
			e.key === "Escape" &&
			drawer &&
			!drawer.classList.contains("hidden")
		) {
			setDrawer(false);
		}
	});

	document.querySelectorAll(".mobile-submenu-toggle").forEach((btn) => {
		btn.addEventListener("click", () => {
			const parent = btn.closest(".mobile-menu-item");
			const subMenu = parent?.querySelector(".mobile-sub-menu");
			if (!subMenu) return;
			const willOpen = subMenu.classList.contains("hidden");
			subMenu.classList.toggle("hidden", !willOpen);
			btn.setAttribute("aria-expanded", String(willOpen));
		});
	});
</script>
