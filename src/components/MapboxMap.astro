---
import mapsData from '../data/maps.json';
import type { MapConfig } from '../types/maps';

interface Props {
  mapId: string;
}

const { mapId } = Astro.props;
const rawConfig = (mapsData as unknown as Record<string, MapConfig>)[mapId];
const mapboxToken = import.meta.env.PUBLIC_MAPBOX_ACCESS_TOKEN ?? '';
const mapConfig: MapConfig | null = rawConfig ? { ...rawConfig, accessToken: mapboxToken } : null;
---

{mapConfig && (
  <div
    class="neu-map-wrapper"
    style={`height: ${mapConfig.height || '550px'}; min-height: 420px;`}
    role="region"
    aria-label={mapConfig.title ? `${mapConfig.title} interactive map` : 'Interactive community map'}
  >
    {mapConfig.categoryFilter && mapConfig.categories && mapConfig.categories.length > 0 && (
      <div
        class="neu-map-filter card bg-base-100/95 backdrop-blur-md border border-base-300 shadow-lg"
        id={`map-filter-${mapId}`}
        role="group"
        aria-label="Map layer filters"
      >
        <div class="neu-map-filter-header">
          <span class="neu-map-filter-title">Map Layers</span>
          <div class="neu-map-filter-actions">
            <button
              type="button"
              class="btn btn-xs btn-outline btn-secondary"
              data-action="all"
              aria-label="Show all map layers"
            >
              All
            </button>
            <button
              type="button"
              class="btn btn-xs btn-outline btn-secondary"
              data-action="none"
              aria-label="Hide all map layers"
            >
              None
            </button>
          </div>
        </div>
        <div class="neu-map-filter-list">
          {mapConfig.categories.map((cat, idx) => (
            <label class="neu-map-filter-item">
              <input
                type="checkbox"
                class="checkbox checkbox-xs checkbox-primary"
                value={cat.slug}
                checked={idx < 2}
              />
              <span class="neu-map-filter-label">{cat.name}</span>
            </label>
          ))}
        </div>
      </div>
    )}
    <div
      id={`mapbox-container-${mapId}`}
      class="neu-mapbox-canvas"
      data-map-config={JSON.stringify(mapConfig)}
    ></div>
  </div>
)}

<script>
  import mapboxgl from 'mapbox-gl';
  import 'mapbox-gl/dist/mapbox-gl.css';
  import { createPopupElement, formatCategorySlug } from '../lib/mapPopup';
  import type { MapConfig } from '../types/maps';

  function getCategoryLabel(
    categories: string[] | undefined,
    catMap: Record<string, string>
  ): string {
    const slug = categories?.[0];
    if (!slug) return '';
    return catMap[slug] || formatCategorySlug(slug);
  }

  function initMaps(): void {
    const containers = document.querySelectorAll<HTMLElement>(
      '.neu-mapbox-canvas:not([data-initialized])'
    );

    containers.forEach((container) => {
      const rawCfg = container.getAttribute('data-map-config');
      if (!rawCfg) return;
      container.setAttribute('data-initialized', 'true');

      const cfg: MapConfig = JSON.parse(rawCfg);
      mapboxgl.accessToken = cfg.accessToken ?? '';

      const catMap: Record<string, string> = {};
      for (const c of cfg.categories ?? []) {
        catMap[c.slug] = c.name;
      }

      const map = new mapboxgl.Map({
        container: container.id,
        style: 'mapbox://styles/mapbox/streets-v12',
        center: cfg.center,
        zoom: cfg.zoom,
        scrollZoom: cfg.scrollZoom !== false,
      });

      if (cfg.zoomControl !== false) {
        map.addControl(new mapboxgl.NavigationControl(), 'top-right');
        map.addControl(new mapboxgl.FullscreenControl(), 'top-right');
      }

      const markersByCat: Array<{ marker: mapboxgl.Marker; categories: string[] }> = [];

      map.on('load', () => {
        // 1. Add Polygon layers
        for (const poly of cfg.polygons ?? []) {
          const sourceId = `poly-src-${poly.id}`;
          const fillId = `poly-fill-${poly.id}`;
          const borderId = `poly-line-${poly.id}`;
          const baseOpacity = typeof poly.opacity === 'number' ? poly.opacity : 0.35;

          map.addSource(sourceId, {
            type: 'geojson',
            data: poly.geojson,
          });

          map.addLayer({
            id: fillId,
            type: 'fill',
            source: sourceId,
            paint: {
              'fill-color': poly.color || '#3FB1CE',
              'fill-opacity': baseOpacity,
            },
          });

          map.addLayer({
            id: borderId,
            type: 'line',
            source: sourceId,
            paint: {
              'line-color': poly.borderColor || '#231f20',
              'line-opacity': typeof poly.borderOpacity === 'number' ? poly.borderOpacity : 0.85,
              'line-width': poly.borderWidth || 2,
            },
          });

          if (poly.popup) {
            const popupData = poly.popup;
            const catName = getCategoryLabel(poly.categories, catMap);

            map.on('click', fillId, (e) => {
              const domContent = createPopupElement(popupData, {
                color: poly.color || '#d7935b',
                categoryLabel: catName,
              });
              new mapboxgl.Popup({
                maxWidth: '340px',
                className: 'neu-mapbox-popup',
                closeButton: true,
              })
                .setLngLat(e.lngLat)
                .setDOMContent(domContent)
                .addTo(map);
            });

            map.on('mouseenter', fillId, () => {
              map.getCanvas().style.cursor = 'pointer';
              map.setPaintProperty(fillId, 'fill-opacity', Math.min(0.65, baseOpacity + 0.18));
            });

            map.on('mouseleave', fillId, () => {
              map.getCanvas().style.cursor = '';
              map.setPaintProperty(fillId, 'fill-opacity', baseOpacity);
            });
          }
        }

        // 2. Add Boundary Line layers (always visible)
        for (const ln of cfg.lines ?? []) {
          const sourceId = `line-src-${ln.id}`;
          const layerId = `line-lyr-${ln.id}`;
          map.addSource(sourceId, {
            type: 'geojson',
            data: ln.geojson,
          });
          map.addLayer({
            id: layerId,
            type: 'line',
            source: sourceId,
            paint: {
              'line-color': ln.color || '#4c4c4c',
              'line-opacity': typeof ln.opacity === 'number' ? ln.opacity : 1,
              'line-width': ln.width || 2.5,
            },
          });
        }

        // 3. Add Locations (Labels or Markers)
        for (const loc of cfg.locations ?? []) {
          const feat = loc.geojson?.features?.[0];
          if (!feat || feat.geometry?.type !== 'Point') continue;
          const coords = feat.geometry.coordinates as [number, number];

          if (loc.style === 'label') {
            const srcId = `loc-lbl-src-${loc.id}`;
            const lyrId = `loc-lbl-lyr-${loc.id}`;
            map.addSource(srcId, {
              type: 'geojson',
              data: loc.geojson,
            });
            map.addLayer({
              id: lyrId,
              type: 'symbol',
              source: srcId,
              layout: {
                'text-field': loc.labelText || loc.title,
                'text-size': loc.labelSize || 24,
                'text-font': ['Open Sans Bold', 'Arial Unicode MS Bold'],
              },
              paint: {
                'text-color': loc.labelColor || '#ffffff',
                'text-halo-color': loc.labelHaloColor || '#231f20',
                'text-halo-width': 2,
              },
            });
          } else {
            const markerColor = loc.markerColor || '#d7935b';
            const marker = new mapboxgl.Marker({ color: markerColor }).setLngLat(coords);
            const mEl = marker.getElement();

            if (mEl) {
              mEl.setAttribute('role', 'button');
              mEl.setAttribute('tabindex', '0');
              mEl.setAttribute(
                'aria-label',
                loc.popup?.title || loc.title || 'Map location marker'
              );
              mEl.style.cursor = 'pointer';
              mEl.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                  e.preventDefault();
                  marker.togglePopup();
                }
              });
            }

            if (loc.popup) {
              const catName = getCategoryLabel(loc.categories, catMap);
              const domContent = createPopupElement(loc.popup, {
                color: markerColor,
                categoryLabel: catName,
              });
              marker.setPopup(
                new mapboxgl.Popup({
                  offset: 25,
                  maxWidth: '340px',
                  className: 'neu-mapbox-popup',
                  closeButton: true,
                }).setDOMContent(domContent)
              );
            }

            marker.addTo(map);
            markersByCat.push({ marker, categories: loc.categories ?? [] });
          }
        }

        // 4. Hook up Category Filter if enabled
        const filterEl = document.getElementById(`map-filter-${cfg.id}`);
        if (filterEl) {
          const applyFilter = () => {
            const checked = Array.from(
              filterEl.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')
            ).map((cb) => cb.value);

            for (const poly of cfg.polygons ?? []) {
              const isVis = (poly.categories ?? []).some((c) => checked.includes(c));
              const visVal = isVis ? 'visible' : 'none';
              if (map.getLayer(`poly-fill-${poly.id}`)) {
                map.setLayoutProperty(`poly-fill-${poly.id}`, 'visibility', visVal);
              }
              if (map.getLayer(`poly-line-${poly.id}`)) {
                map.setLayoutProperty(`poly-line-${poly.id}`, 'visibility', visVal);
              }
            }

            for (const item of markersByCat) {
              const isVis = item.categories.some((c) => checked.includes(c));
              item.marker.getElement().style.display = isVis ? '' : 'none';
            }
          };

          filterEl.addEventListener('change', applyFilter);
          filterEl.querySelectorAll<HTMLButtonElement>('button[data-action]').forEach((btn) => {
            btn.addEventListener('click', () => {
              const checkAll = btn.getAttribute('data-action') === 'all';
              filterEl
                .querySelectorAll<HTMLInputElement>('input[type="checkbox"]')
                .forEach((cb) => {
                  cb.checked = checkAll;
                });
              applyFilter();
            });
          });
          applyFilter();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMaps);
  } else {
    initMaps();
  }
</script>

<style is:global>
  /* Map Container & Filter Card */
  .neu-map-wrapper {
    position: relative;
    width: 100%;
    margin: 24px 0;
    border-radius: 10px;
    border: 1px solid var(--ast-global-color-6);
    overflow: hidden;
    box-shadow: 0 4px 18px rgba(35, 31, 32, 0.08);
    background: var(--ast-global-color-4);
  }

  .neu-mapbox-canvas {
    width: 100%;
    height: 100%;
  }

  .neu-map-filter {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 10;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(8px);
    border: 1px solid var(--ast-global-color-6);
    border-radius: 8px;
    padding: 14px 16px;
    box-shadow: 0 6px 20px rgba(35, 31, 32, 0.14);
    max-height: calc(100% - 28px);
    overflow-y: auto;
    min-width: 225px;
    max-width: 285px;
    font-family: 'Open Sans', sans-serif;
    font-size: 13.5px;
  }

  .neu-map-filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--ast-global-color-0);
  }

  .neu-map-filter-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ast-global-color-2);
    line-height: 1.1;
  }

  .neu-map-filter-actions {
    display: flex;
    gap: 6px;
  }

  .neu-map-filter-actions button {
    background: var(--ast-global-color-4);
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 3px 9px;
    font-family: 'Open Sans', sans-serif;
    font-size: 11.5px;
    font-weight: 600;
    cursor: pointer;
    color: var(--ast-global-color-3);
    transition: all 0.15s ease;
  }

  .neu-map-filter-actions button:hover {
    background: var(--ast-global-color-0);
    color: #ffffff;
    border-color: var(--ast-global-color-0);
  }

  .neu-map-filter-actions button:focus-visible {
    outline: 2px solid var(--ast-global-color-3);
    outline-offset: 2px;
  }

  .neu-map-filter-list {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .neu-map-filter-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 3px 4px;
    border-radius: 4px;
    cursor: pointer;
    color: var(--ast-global-color-2);
    font-weight: 600;
    line-height: 1.3;
    transition: background-color 0.12s ease;
  }

  .neu-map-filter-item:hover {
    background-color: var(--ast-global-color-4);
  }

  .neu-map-filter-item input {
    width: 16px;
    height: 16px;
    accent-color: var(--ast-global-color-0);
    cursor: pointer;
    flex-shrink: 0;
  }

  .neu-map-filter-item input:focus-visible {
    outline: 2px solid var(--ast-global-color-3);
    outline-offset: 2px;
  }

  /* -------------------------------------------------------------------------
     Unified Accessible Mapbox Popup Design System (.neu-mapbox-popup)
     ------------------------------------------------------------------------- */
  .mapboxgl-popup.neu-mapbox-popup {
    z-index: 30;
  }

  .mapboxgl-popup.neu-mapbox-popup .mapboxgl-popup-content {
    padding: 0;
    background: #ffffff;
    border-radius: 10px;
    border: 1px solid var(--ast-global-color-6);
    box-shadow:
      0 14px 34px rgba(35, 31, 32, 0.18),
      0 3px 10px rgba(35, 31, 32, 0.08);
    overflow: hidden;
    font-family: 'Open Sans', sans-serif;
    color: var(--ast-global-color-3);
  }

  .mapboxgl-popup.neu-mapbox-popup .mapboxgl-popup-close-button {
    top: 12px;
    right: 10px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--ast-global-color-4);
    border: 1px solid #d1d5db;
    color: var(--ast-global-color-2);
    font-size: 18px;
    font-weight: 700;
    line-height: 28px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
    z-index: 5;
  }

  .mapboxgl-popup.neu-mapbox-popup .mapboxgl-popup-close-button:hover {
    background: var(--ast-global-color-0);
    border-color: var(--ast-global-color-0);
    color: #ffffff;
  }

  .mapboxgl-popup.neu-mapbox-popup .mapboxgl-popup-close-button:focus-visible {
    outline: 2px solid var(--ast-global-color-3);
    outline-offset: 2px;
  }

  .neu-popup-card {
    display: flex;
    flex-direction: column;
    min-width: 240px;
  }

  .neu-popup-accent {
    height: 5px;
    width: 100%;
    background: var(--ast-global-color-0);
  }

  .neu-popup-inner {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .neu-popup-badge {
    align-self: flex-start;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ast-global-color-3);
    background: var(--ast-global-color-4);
    border: 1px solid #cbd5e1;
    padding: 2px 8px;
    border-radius: 999px;
    margin-right: 32px;
  }

  .neu-popup-title {
    margin: 0;
    padding-right: 32px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--ast-global-color-0);
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--ast-global-color-2);
  }

  .neu-popup-rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--ast-global-color-3);
  }

  .neu-popup-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .neu-popup-row.neu-popup-lead {
    color: var(--ast-global-color-2);
    font-size: 14px;
  }

  .neu-popup-row.neu-popup-address {
    color: var(--ast-global-color-3);
  }

  .neu-popup-icon {
    color: var(--ast-global-color-0);
    flex-shrink: 0;
    margin-top: 2px;
    display: inline-flex;
    align-items: center;
  }

  .neu-popup-link,
  .neu-popup-inline-link {
    color: var(--ast-global-color-3);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    word-break: break-word;
    transition: color 0.15s ease;
  }

  .neu-popup-link:hover,
  .neu-popup-inline-link:hover {
    color: var(--ast-global-color-0);
  }

  .neu-popup-link:focus-visible,
  .neu-popup-inline-link:focus-visible {
    outline: 2px solid var(--ast-global-color-3);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .neu-popup-text {
    color: var(--ast-global-color-3);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .neu-popup-text p {
    margin: 0 0 6px 0;
  }

  .neu-popup-text p:last-child {
    margin-bottom: 0;
  }

  .neu-popup-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
    padding-top: 8px;
    border-top: 1px solid #e2e8f0;
  }

  .neu-popup-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 8px 14px;
    background-color: var(--ast-global-color-3);
    color: #ffffff !important;
    font-family: 'Open Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    border-radius: 6px;
    text-decoration: none !important;
    transition: background-color 0.15s ease;
  }

  .neu-popup-cta-btn:hover {
    background-color: var(--ast-global-color-0);
    color: #ffffff !important;
  }

  .neu-popup-cta-btn:focus-visible {
    outline: 2px solid var(--ast-global-color-2);
    outline-offset: 2px;
  }

  /* Mapbox Control Button Accessibility Enhancements */
  .neu-map-wrapper .mapboxgl-ctrl-group button:focus-visible,
  .cs-map-pane .mapboxgl-ctrl-group button:focus-visible {
    outline: 2px solid var(--ast-global-color-0);
    outline-offset: -2px;
  }
</style>
